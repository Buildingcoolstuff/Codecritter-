{
  "name": "codecritter",
  "displayName": "CodeCritter 🐾",
  "description": "A virtual pet that lives in your status bar and reacts to how you code — with stats, streaks, achievements, and an animated dashboard.",
  "version": "1.1.0",
  "publisher": "adnan9-63",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2d2d4a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Buildingcoolstuff/Codecritter-.git"
  },
  "homepage": "https://github.com/Buildingcoolstuff/Codecritter-#readme",
  "bugs": {
    "url": "https://github.com/Buildingcoolstuff/Codecritter-/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["pet", "fun", "gamification", "status bar", "productivity", "tamagotchi", "companion", "critter", "motivation", "streak"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codecritter.sayHi",
        "title": "CodeCritter: Say Hi 👋",
        "category": "CodeCritter"
      },
      {
        "command": "codecritter.showDashboard",
        "title": "CodeCritter: Show Dashboard 📊",
        "category": "CodeCritter"
      },
      {
        "command": "codecritter.resetStats",
        "title": "CodeCritter: Reset All Stats 🗑️",
        "category": "CodeCritter"
      },
      {
        "command": "codecritter.setDailyGoal",
        "title": "CodeCritter: Set Daily Goal 🎯",
        "category": "CodeCritter"
      },
      {
        "command": "codecritter.choosePetTheme",
        "title": "CodeCritter: Choose Pet Theme 🎨",
        "category": "CodeCritter"
      }
    ],
    "configuration": {
      "title": "CodeCritter",
      "properties": {
        "codecritter.petName": {
          "type": "string",
          "default": "Critter",
          "description": "Give your CodeCritter a name! It will appear in the tooltip and notifications.",
          "maxLength": 20
        },
        "codecritter.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeCritter in the status bar."
        },
        "codecritter.dailyGoal": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 100000,
          "description": "Your daily lines-typed goal. CodeCritter celebrates when you hit it!"
        },
        "codecritter.enableTips": {
          "type": "boolean",
          "default": true,
          "description": "Show motivational tips and coding tips in notifications."
        },
        "codecritter.statusBarAlignment": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "right",
          "description": "Which side of the status bar CodeCritter appears on (requires restart)."
        },
        "codecritter.petTheme": {
          "type": "string",
          "enum": ["default", "fire", "galaxy", "nature"],
          "enumDescriptions": [
            "Teal — the classic CodeCritter look",
            "Fire — warm orange and red tones",
            "Galaxy — deep purple and indigo tones",
            "Nature — earthy green tones"
          ],
          "default": "default",
          "description": "Color theme for your CodeCritter in the dashboard."
        },
        "codecritter.breakReminder": {
          "type": "boolean",
          "default": false,
          "description": "Remind you to take a break after extended coding sessions."
        },
        "codecritter.breakReminderInterval": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "maximum": 180,
          "description": "How many minutes of continuous coding before a break reminder (requires breakReminder: true)."
        },
        "codecritter.weeklyReview": {
          "type": "boolean",
          "default": true,
          "description": "Show a weekly coding summary when you open VS Code on Monday."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
